NODE_ENV=development
SERVICE_HOST=127.0.0.1
SERVICE_PORT=3001
DATABASE_URL=postgres://leaderboard:leaderboard@127.0.0.1:5432/leaderboard_dev
# Set to 1 only when intentionally importing tests/fixtures into a local database.
ALLOW_SYNTHETIC_FIXTURES=0
# Configured public target for local plans/examples; no DNS, deployment or host approval.
PUBLIC_ORIGIN=https://leaderboard.pickyour.ai
CONTROLS_OAUTH_CALLBACK=https://leaderboard.pickyour.ai/controls/auth/callback
VITE_PUBLIC_API_BASE=/api/v1
