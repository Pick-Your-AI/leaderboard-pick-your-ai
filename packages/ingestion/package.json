{
  "name": "@pick-your-ai/ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist", "sql"],
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "start:service": "node dist/cli.js service",
    "start:worker": "node dist/cli.js worker",
    "replay": "node dist/cli.js replay",
    "snapshot:publish": "node dist/cli.js snapshot-publish",
    "snapshot:latest": "node dist/cli.js snapshot-latest",
    "snapshot:read": "node dist/cli.js snapshot-read"
  },
  "dependencies": { "pg": "8.16.3" },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "typescript": "7.0.2"
  }
}
